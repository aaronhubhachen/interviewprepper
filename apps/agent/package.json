{
  "name": "@synapse/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Prepr iMessage agent (Photon spectrum-ts).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "terminal": "tsx src/index.ts --terminal",
    "simulate": "tsx src/simulate.ts",
    "simulate:offline": "tsx src/simulate.ts --heuristic",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@synapse/core": "*",
    "spectrum-ts": "^12.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.20.6"
  }
}
