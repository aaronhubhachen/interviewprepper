# Prepr configuration. Copy to .env at the repo root (it is gitignored).
# Both the web app (apps/web) and the iMessage agent (apps/agent) load this file
# via @synapse/core's loadEnv(); variables already set in the shell win.
# Every value below is optional except the Photon credentials for the live agent.

# ── Photon (iMessage via spectrum-ts) ─────────────────────────────────────────
# Project credentials from https://app.photon.codes. Not needed for the web app
# or for `npm run agent:terminal` / `npm run agent:simulate`.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# ── LLM (any OpenAI-compatible API) ───────────────────────────────────────────
# Precedence: META_MODEL_API_KEY → GROQ_API_KEY → OPENAI_API_KEY. With no key,
# grading and sparring feedback fall back to deterministic heuristics, so the
# whole product still works offline.
META_MODEL_API_KEY=
# META_API_BASE_URL=https://api.meta.ai/v1
GROQ_API_KEY=
OPENAI_API_KEY=

# Override the primary provider's model (defaults: muse-spark-1.3 / llama-3.3-70b-versatile / gpt-4o).
# MODEL_NAME=muse-spark-1.3
# Comma-separated models tried on the primary provider before the other providers.
# MODEL_FALLBACK=
# Total time budget per LLM call, across fallbacks (ms).
# SYNAPSE_LLM_TIMEOUT_MS=12000
# Set to 1 to force the heuristic evaluators even when keys are present.
# SYNAPSE_DISABLE_LLM=0
# Tip for demos: set two providers (e.g. Muse + a free Groq key). A dropped connection is retried once,
# then the next provider answers, so Prepr Bot and the resume grill rarely fall back to offline mode.

# Server judge for Java, C++, Go and TypeScript (uses javac/java, clang++ or g++, go, node). It runs
# submitted code on this machine without a sandbox: on by default in dev, off in production unless set to 1.
# SYNAPSE_NATIVE_JUDGE=1

# ── Storage & identity ────────────────────────────────────────────────────────
# SQLite file shared by the web server and the agent (relative paths resolve from the repo root).
# SYNAPSE_DB_PATH=data/synapse.db
# The single web user; its dashboard shows a 6-digit code to text as "link 482193"
# (codes expire after 10 minutes; the dashboard always shows the current one).
# SYNAPSE_WEB_USER_ID=me
# Public URL of the web app, used in texts that link to the dashboard or IDE. It is
# also the only non-loopback host the web app answers. The web app binds to
# 127.0.0.1; to open it from a phone on your Wi-Fi, set this to the LAN URL (e.g.
# http://192.168.1.20:3000) and run `npm run dev:lan -w @synapse/web`. That exposes
# the unauthenticated dashboard, link code and transcripts to your whole network.
# SYNAPSE_WEB_URL=http://localhost:3000
# Optional phone number or email the agent may DM first (e.g. +15551234567). It is
# also the only handle that can link by texting "start" (everyone else needs the code).
# SYNAPSE_OWNER_HANDLE=
# Optional: the Prepr iMessage number/email (your Photon line). The dashboard's
# link card shows it and offers an sms: "Open Messages" button. As an E.164 number it
# also picks the line the agent opens the owner's DM on.
# SYNAPSE_AGENT_HANDLE=
# Set to 1 to also log message text (answers). Off by default; phone numbers and
# emails are masked in the log either way.
# SYNAPSE_VERBOSE=0
# Set to "terminal" to chat through the local tuichat window instead of iMessage
# (same as `npm run agent:terminal`).
# SYNAPSE_AGENT_PROVIDER=

# ── Spaced repetition & scheduling ────────────────────────────────────────────
# Real milliseconds per SRS "day". 86400000 is real time; 60000 makes one SRS day
# one minute so cards come back live during a demo. Below 3600000 (one hour),
# active-hours limits are ignored so demos work at any time.
# SYNAPSE_DAY_MS=86400000
# IANA time zone for active hours, mornings, streaks, and daily caps.
# SYNAPSE_TIMEZONE=America/Chicago
# Local hours during which the agent may text: start inclusive, end exclusive.
# SYNAPSE_ACTIVE_HOURS=8-22
# Local hour of the "☕ Morning Prepr" briefing and of drills queued by IDE struggles.
# SYNAPSE_MORNING_HOUR=9
# Proactive texts per user per local day.
# SYNAPSE_MAX_DAILY_PUSHES=12
# New cards introduced per user per day.
# SYNAPSE_NEW_PER_DAY=8
# How often the agent's scheduler loop wakes up (ms).
# SYNAPSE_TICK_MS=30000
